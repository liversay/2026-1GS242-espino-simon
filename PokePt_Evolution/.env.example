# ─── Clerk (auth) ────────────────────────────────────────────────
# Obtener en https://dashboard.clerk.com → tu app → API Keys
# Copiar en apps/web/.env.local
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Copiar en apps/api/.env.local
CLERK_SECRET_KEY=sk_test_...

# ─── Stripe (billing — Fase 4) ────────────────────────────────────
# Modo test: https://dashboard.stripe.com → Developers → API Keys
# Copiar en apps/api/.env.local
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Copiar en apps/web/.env.local (solo si usas Stripe Elements)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Webhooks en local (Stripe CLI) ───────────────────────────────
# stripe listen --forward-to localhost:3001/billing/webhook
