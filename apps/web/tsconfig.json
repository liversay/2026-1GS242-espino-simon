{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@pokept/shared": ["../../../packages/shared/src/index.ts"],
      "@pokept/shared/*": ["../../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../packages/shared/src/**/*.ts"]
}
